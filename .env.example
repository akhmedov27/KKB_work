QMS_DATA_DIR=data
QMS_MAX_UPLOAD_MB=10
# mock (default), cloud (DeepSeek), local (existing loopback server)
QMS_AI_PROVIDER=mock
QMS_CLOUD_ENABLED=false
QMS_CLOUD_ENDPOINT=https://api.deepseek.com/chat/completions
QMS_CLOUD_MODEL=deepseek-chat
# Enter the API key only in your private .env; never commit it or paste in chat.
QMS_CLOUD_API_KEY=
QMS_LOCAL_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
QMS_LOCAL_MODEL=
QMS_AI_TIMEOUT_SECONDS=20
QMS_AI_MAX_TOKENS=512
